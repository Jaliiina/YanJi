# OpenAI-compatible endpoint. The key stays on the local backend.
api_key=
base_url=https://your-provider.example/v1
model=qwen3.8-flash
YANJI_PORT=8810

# Optional literature API; generic POST /search and GET /papers/{id}.
literature_url=
literature_api_key=
literature_kind=generic
# Set kind=localbase to use BioFlow ai-localbase, with an explicit knowledge-base ID.
literature_kb=
